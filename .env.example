# ==== Server ====
PORT=8787
WEB_URL=http://localhost:5173
# Chuỗi bí mật để ký JWT (đổi thành chuỗi ngẫu nhiên dài)
JWT_SECRET=doi_thanh_chuoi_bi_mat_that_dai_ngau_nhien

# ==== Google OAuth (Google Cloud Console → Credentials → OAuth client ID: Web) ====
# Authorized redirect URI phải khớp đúng dòng dưới:
#   http://localhost:8787/auth/google/callback
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# ==== Groq (console.groq.com → API Keys) ====
GROQ_API_KEY=gsk_xxx
# Model ổn định, luôn có sẵn trên Groq. Xem model khả dụng ở console.groq.com.
GROQ_MODEL=llama-3.3-70b-versatile
# Số email gửi Groq cùng lúc. Gói free giới hạn theo token/phút => để thấp (1-2).
GROQ_CONCURRENCY=2

# ==== Supabase (Project Settings → API) ====
SUPABASE_URL=https://xxxx.supabase.co
# Dùng service_role key (chỉ ở backend, KHÔNG để lộ ra frontend)
SUPABASE_SERVICE_KEY=eyJ...

# Số email sẽ quét mỗi lần đồng bộ
GMAIL_MAX_RESULTS=100
# Bộ lọc Gmail: chỉ lấy email có tiêu đề chứa "THƯ MỜI NHẬN VIỆC".
# Để trống = quét mail gần nhất rồi tự lọc bằng từ khoá + Groq.
# Khớp mẫu tiêu đề "THƯ MỜI NHẬN VIỆC_..." (chỉ lấy 3 chữ đầu vì chữ VIỆC hay
# bị dính gạch dưới như VIỆC_TTS làm hỏng khớp cụm đủ 4 chữ).
GMAIL_QUERY=subject:"thư mời nhận"
